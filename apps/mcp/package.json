{
  "name": "open-intelligent-ui-mcp",
  "version": "0.1.0",
  "description": "Standalone MCP server for Open Intelligent UI design system and skills",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/build-kit.mjs && tsx watch src/index.ts",
    "dev:stdio": "node scripts/build-kit.mjs && tsx src/stdio.ts",
    "build:kit": "node scripts/build-kit.mjs",
    "build:worker": "node scripts/build-kit.mjs && node scripts/build-worker.mjs",
    "build": "node scripts/build-kit.mjs && tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "lint": "tsc --noEmit",
    "test": "node scripts/build-kit.mjs && vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "generative-ui",
    "design-system"
  ],
  "author": "CopilotKit",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@repo/design-system": "workspace:*",
    "hono": "^4",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.27.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
